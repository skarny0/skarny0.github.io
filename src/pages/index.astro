---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const pubs = await getCollection('publications');
const selected = pubs
  .filter((p) => p.data.selected)
  .sort((a, b) => (a.data.selectedOrder ?? 99) - (b.data.selectedOrder ?? 99));
const pubLink = (p: (typeof pubs)[number]) =>
  p.data.links?.doi ?? p.data.links?.arxiv ?? p.data.links?.paper;
---

<Layout title="Sheer Karny" active="home">
  <Fragment slot="hero">
    <div class="hero-home">
      <div class="hero-text">
        <div class="label eyebrow">Graduate Researcher · MIT Media Lab</div>
        <h1>Sheer Karny</h1>
        <p class="tagline">Designing assistants, agents, and interfaces that complement human cognition, decision-making, and well-being.</p>
      </div>
      <div data-topic-zone></div>
    </div>
  </Fragment>

  <section class="bio">
    <figure>
      <div class="crop headshot"><img src="/images/headshot.jpg" alt="Sheer Karny" width="600" height="600" /></div>
    </figure>
    <div class="bio-text">
      <p>Multidisciplinary researcher at the <a href="https://www.media.mit.edu/people/skarny/overview/" target="_blank"><strong>MIT Media Lab</strong></a>, studying human-AI interaction in the <a href="https://cyborglab.org/" target="_blank">Cyborg Psychology</a> group, advised by Pat Pataranutaporn and Pattie Maes. This summer I interned with Aaron Zinman as a prototyper on an Incubation team within <strong>Apple</strong>'s Intelligent System Experience org (SWE).</p>
      <p>A through-line of my research is creating collaborative AI systems — designing assistants, agents, and interfaces that complement human cognition, decision-making, and well-being. My recent work bridges mechanistic interpretability (making sense of neural-level activity in LLMs) and user interfaces to create safer human-chatbot interactions, helping dub the term <strong>Neural Transparency</strong>.</p>
      <p>This connects to my contributions to a recent pre-print, <a href="https://arxiv.org/abs/2509.11391" target="_blank"><em>"My Boyfriend is AI"</em></a>, underscoring a desire to understand the individual and societal-level implications of the increasing prevalence of human-AI companionship. This work has been covered by <strong>MIT Tech Review</strong>, <strong>The Guardian</strong>, and <strong>The New York Times</strong>, among others.</p>
      <p class="bio-prev">Previously a Junior Specialist at UC Irvine working with Mark Steyvers on human-AI teaming, in collaboration with Honda Research Institute USA. B.A. in Cognitive Science (Honors) with a minor in Data Science from UC Berkeley.</p>
    </div>
  </section>

  <section class="section">
    <div class="label">Selected work</div>
    <div class="sel-list">
      {selected.map((p) => (
        <div class="sel-row">
          <span class="sel-year">{p.data.year}</span>
          <div>
            <a class="sel-title" href={pubLink(p)} target="_blank">{p.data.title}</a>
            <div class="sel-venue"><em>{p.data.selectedVenue}</em></div>
          </div>
        </div>
      ))}
      <a class="all-pubs" href="/publications">All publications →</a>
    </div>
  </section>
</Layout>

<style>
  .bio{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:48px;padding:80px 0 72px;border-bottom:1px solid var(--hair)}
  .bio figure{max-width:300px}
  .headshot{aspect-ratio:1/1}
  .headshot img{filter:grayscale(.15)}
  .bio-text{grid-column:span 2;min-width:0;font-size:18px;line-height:1.65;text-wrap:pretty}
  .bio-text p{margin:0 0 20px}
  .bio-text strong{font-weight:600}
  .bio-text .bio-prev{margin:0;font-size:17px;color:var(--muted)}

  .sel-list{display:flex;flex-direction:column}
  .sel-row{display:grid;grid-template-columns:56px minmax(0,1fr);gap:16px;padding:18px 0;border-top:1px solid var(--hair-row)}
  .sel-year{font-family:var(--two);font-weight:500;font-size:12px;color:var(--faint);padding-top:5px}
  .sel-title{font-size:19px;font-weight:500;line-height:1.35;text-decoration:none;text-wrap:pretty}
  .sel-venue{font-size:15px;color:var(--muted);margin-top:4px}
  .all-pubs{margin-top:20px;font-family:var(--two);font-weight:500;font-size:12px;align-self:flex-start}
</style>
